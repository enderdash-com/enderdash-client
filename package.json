{
  "name": "@enderdash/client",
  "version": "0.1.5",
  "description": "Generated TypeScript client for the Enderdash HTTP API.",
  "keywords": [
    "api-client",
    "enderdash",
    "minecraft",
    "openapi",
    "server-management",
    "trpc",
    "typescript"
  ],
  "homepage": "https://enderdash.com",
  "bugs": {
    "url": "https://github.com/enderdash-com/enderdash-client/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Enderdash",
    "url": "https://enderdash.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enderdash-com/enderdash-client.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && bun run lint && bun run format:check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "bun scripts/generate.ts",
    "pack:check": "bun pm pack --dry-run",
    "prepack": "bun run build",
    "test": "bun test tests",
    "prepare": "lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "pre-commit": "lefthook run pre-commit"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@trpc/openapi": "11.17.0-alpha",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.74.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.0.0",
    "effect": "4.1.7",
    "lefthook": "2.2.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.8"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.5"
}
